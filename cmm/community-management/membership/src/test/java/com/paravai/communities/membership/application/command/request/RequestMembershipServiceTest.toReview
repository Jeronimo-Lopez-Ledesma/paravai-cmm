package com.paravai.communities.membership.application.command.request;

import com.fasterxml.jackson.databind.ObjectMapper;
import com.paravai.communities.membership.application.event.MembershipEventFactory;
import com.paravai.communities.membership.domain.model.Membership;
import com.paravai.communities.membership.domain.model.MembershipFactory;
import com.paravai.communities.membership.domain.repository.MembershipRepository;
import com.paravai.foundation.domain.event.ReactiveDomainEventPublisher;
import com.paravai.foundation.domain.value.IdValue;
import com.paravai.foundation.observability.metrics.ReactiveOperationMetrics;
import com.paravai.foundation.snapshot.SnapshotMapper;
import org.junit.jupiter.api.BeforeEach;
import org.junit.jupiter.api.Test;
import reactor.core.publisher.Mono;
import reactor.test.StepVerifier;
import reactor.util.context.Context;

import static org.mockito.ArgumentMatchers.any;
import static org.mockito.Mockito.*;

class RequestMembershipServiceTest {

    private MembershipRepository repo;
    private ReactiveDomainEventPublisher publisher;
    private SnapshotMapper<Membership> snapshotMapper;
    private MembershipEventFactory eventFactory;
    private ReactiveOperationMetrics metrics;

    private RequestMembershipService service;

    @BeforeEach
    void setUp() {
        repo = mock(MembershipRepository.class);
        publisher = mock(ReactiveDomainEventPublisher.class);
        snapshotMapper = mock(SnapshotMapper.class);
        eventFactory = mock(MembershipEventFactory.class);
        metrics = mock(ReactiveOperationMetrics.class);

        service = new RequestMembershipService(
                repo,
                publisher,
                snapshotMapper,
                eventFactory,
                metrics
        );
    }

    @Test
    void shouldCreatePendingMembershipWhenNoneExists() {
        IdValue tenantId = IdValue.generate();
        IdValue communityId = IdValue.generate();
        IdValue userId = IdValue.generate();

        Membership created = MembershipFactory.createPendingRequest(tenantId, communityId, userId);

        when(repo.findByTenantIdAndCommunityIdAndUserId(tenantId, communityId, userId))
                .thenReturn(Mono.empty());

        when(repo.save(any(Membership.class))).thenReturn(Mono.just(created));
        when(snapshotMapper.map(any(Membership.class))).thenReturn(new ObjectMapper().createObjectNode());
        when(eventFactory.build(any(), any(), any(), any(), any(), any(), any(), any()))
                .thenReturn(mock(com.paravai.foundation.domain.event.EntityChangedEvent.class));
        when(publisher.publish(any())).thenReturn(Mono.empty());

        StepVerifier.create(
                        service.request(tenantId, communityId, userId)
                                .contextWrite(Context.of(
                                        "traceId", "trace-1",
                                        "userOid", userId.value(),
                                        "sourceSystem", "test"
                                ))
                )
                .assertNext(result -> {
                    assert result.created();
                    assert result.membership().status().isPending();
                })
                .verifyComplete();

        verify(repo).save(any(Membership.class));
        verify(publisher).publish(any());
    }

    @Test
    void shouldReturnExistingPendingMembershipWithoutPublishingEvent() {
        IdValue tenantId = IdValue.generate();
        IdValue communityId = IdValue.generate();
        IdValue userId = IdValue.generate();

        Membership existing = MembershipFactory.createPendingRequest(tenantId, communityId, userId);

        when(repo.findByTenantIdAndCommunityIdAndUserId(tenantId, communityId, userId))
                .thenReturn(Mono.just(existing));

        StepVerifier.create(
                        service.request(tenantId, communityId, userId)
                                .contextWrite(Context.of(
                                        "traceId", "trace-1",
                                        "userOid", userId.value(),
                                        "sourceSystem", "test"
                                ))
                )
                .assertNext(result -> {
                    assert !result.created();
                    assert result.membership().id().equals(existing.id());
                })
                .verifyComplete();

        verify(repo, never()).save(any());
        verify(publisher, never()).publish(any());
    }

    @Test
    void shouldFailWhenMembershipAlreadyActive() {
        IdValue tenantId = IdValue.generate();
        IdValue communityId = IdValue.generate();
        IdValue userId = IdValue.generate();

        Membership active = MembershipFactory.createActiveMember(tenantId, communityId, userId);

        when(repo.findByTenantIdAndCommunityIdAndUserId(tenantId, communityId, userId))
                .thenReturn(Mono.just(active));

        StepVerifier.create(
                        service.request(tenantId, communityId, userId)
                                .contextWrite(Context.of(
                                        "traceId", "trace-1",
                                        "userOid", userId.value(),
                                        "sourceSystem", "test"
                                ))
                )
                .expectErrorMatches(ex -> ex instanceof IllegalArgumentException
                        && ex.getMessage().contains("already an active member"))
                .verify();

        verify(repo, never()).save(any());
        verify(publisher, never()).publish(any());
    }

    @Test
    void shouldFailWhenMembershipAlreadyRejected() {
        IdValue tenantId = IdValue.generate();
        IdValue communityId = IdValue.generate();
        IdValue userId = IdValue.generate();

        Membership rejected = MembershipFactory.createRejected(tenantId, communityId, userId, "Rejected before");

        when(repo.findByTenantIdAndCommunityIdAndUserId(tenantId, communityId, userId))
                .thenReturn(Mono.just(rejected));

        StepVerifier.create(
                        service.request(tenantId, communityId, userId)
                                .contextWrite(Context.of(
                                        "traceId", "trace-1",
                                        "userOid", userId.value(),
                                        "sourceSystem", "test"
                                ))
                )
                .expectErrorMatches(ex -> ex instanceof IllegalArgumentException
                        && ex.getMessage().contains("rejected membership request"))
                .verify();

        verify(repo, never()).save(any());
        verify(publisher, never()).publish(any());
    }
}